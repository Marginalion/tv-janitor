diff --git a/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java b/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
index d992768a..664b2de1 100644
--- a/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
+++ b/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
@@ -369,9 +369,24 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
         }
     };
 
+    /** Once per launcher process: TV Janitor gets a nudge even when it was force-stopped (no boot broadcast then). */
+    private static boolean janitorNudged;
+
+    private void nudgeJanitor() {
+        if (janitorNudged) return;
+        janitorNudged = true;
+        try {
+            Intent i = new Intent("io.github.marginalion.tvjanitor.HOME_UP")
+                    .setComponent(new ComponentName("io.github.marginalion.tvjanitor", "io.github.marginalion.tvjanitor.BootReceiver"))
+                    .addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES);
+            sendBroadcast(i);
+        } catch (RuntimeException ignored) { }
+    }
+
     @Override
     protected void onCreate(Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
+        nudgeJanitor();
         setContentView(R.layout.activity_main);
         density = getResources().getDisplayMetrics().density;
         // config.xml, overlaid by config.json from a pushed theme (see Config and tools/theme.sh).
