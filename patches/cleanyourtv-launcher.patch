+        // Only the main settings screen is redirected; Wi-Fi and other pages keep the standard route.
+        if (Settings.ACTION_SETTINGS.equals(action)) {
+            Intent preferred = firstInstalled(context, R.array.settings_preferred_components);
+            if (preferred != null) return preferred;
+        }
